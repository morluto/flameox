# Flamo environment variables
# Copy this file to .env and adjust values for local development.

# Override the default .diagnostics/ workspace directory
# FLAMO_PROJECT_ROOT=.

# Path to Perfetto Trace Processor binary (optional, for trace analysis)
# FLAMO_PERFETTO_TRACE_PROCESSOR=/usr/bin/trace_processor

# Log level for the CLI (DEBUG, INFO, WARNING, ERROR)
# FLAMO_LOG_LEVEL=INFO
