{
  "$defs": {
    "ArtifactKernelBuildStage": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/KernelBuildArtifact"
        },
        "elapsed_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Ns"
        },
        "format": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "format_schema": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Format Schema",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ordinal": {
          "maximum": 99,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "predecessor": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor"
        },
        "status": {
          "enum": [
            "available",
            "cached"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ordinal",
        "format",
        "format_schema",
        "status",
        "artifact"
      ],
      "title": "ArtifactKernelBuildStage",
      "type": "object"
    },
    "ArtifactlessKernelBuildStage": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "const": null,
          "default": null,
          "title": "Artifact",
          "type": "null"
        },
        "elapsed_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Ns"
        },
        "format": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "format_schema": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Format Schema",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ordinal": {
          "maximum": 99,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "predecessor": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor"
        },
        "status": {
          "enum": [
            "skipped",
            "unavailable",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ordinal",
        "format",
        "format_schema",
        "status"
      ],
      "title": "ArtifactlessKernelBuildStage",
      "type": "object"
    },
    "KernelBuildArtifact": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "default": "application/octet-stream",
          "maxLength": 100,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "default": "compiler_stage",
          "maxLength": 100,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "byte_length",
        "sha256"
      ],
      "title": "KernelBuildArtifact",
      "type": "object"
    },
    "KernelBuildCacheStatus": {
      "enum": [
        "hit",
        "miss",
        "mixed",
        "unknown"
      ],
      "title": "KernelBuildCacheStatus",
      "type": "string"
    },
    "KernelBuildContext": {
      "additionalProperties": false,
      "description": "Exact identity claims about the input and protocol of one build.",
      "properties": {
        "build_protocol_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Protocol Id",
          "type": "string"
        },
        "command_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Command Digest",
          "type": "string"
        },
        "compiler_identity_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compiler Identity Id",
          "type": "string"
        },
        "parameters_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Digest",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/KernelBuildTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_identity_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Identity Id"
        },
        "workload_definition_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Workload Definition Id",
          "type": "string"
        },
        "workload_instance_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Workload Instance Id",
          "type": "string"
        }
      },
      "required": [
        "workload_definition_id",
        "workload_instance_id",
        "command_digest",
        "parameters_digest",
        "compiler_identity_id",
        "build_protocol_id"
      ],
      "title": "KernelBuildContext",
      "type": "object"
    },
    "KernelBuildOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "inconclusive"
      ],
      "title": "KernelBuildOutcome",
      "type": "string"
    },
    "KernelBuildStage": {
      "discriminator": {
        "mapping": {
          "available": "#/$defs/ArtifactKernelBuildStage",
          "cached": "#/$defs/ArtifactKernelBuildStage",
          "failed": "#/$defs/ArtifactlessKernelBuildStage",
          "skipped": "#/$defs/ArtifactlessKernelBuildStage",
          "unavailable": "#/$defs/ArtifactlessKernelBuildStage"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ArtifactKernelBuildStage"
        },
        {
          "$ref": "#/$defs/ArtifactlessKernelBuildStage"
        }
      ]
    },
    "KernelBuildTarget": {
      "additionalProperties": false,
      "description": "Compiler target selected for a managed build.\n\nTriton exposes this shape as a backend, architecture, and warp size. Other\ncompiler adapters can use the same bounded vocabulary without claiming a\ntarget when they cannot establish it.",
      "properties": {
        "architecture": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.+-]+$",
          "title": "Architecture",
          "type": "string"
        },
        "backend": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Backend",
          "type": "string"
        },
        "warp_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1024,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warp Size"
        }
      },
      "required": [
        "backend",
        "architecture"
      ],
      "title": "KernelBuildTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Build manifest with an exact, independently verifiable input context.",
  "properties": {
    "build_context": {
      "$ref": "#/$defs/KernelBuildContext"
    },
    "cache_status": {
      "$ref": "#/$defs/KernelBuildCacheStatus",
      "default": "unknown"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Diagnostics",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Limitations",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/KernelBuildOutcome"
    },
    "producer": {
      "enum": [
        "triton",
        "cute"
      ],
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Producer Version",
      "type": "string"
    },
    "schema_version": {
      "const": "flameox.kernel-build.v2",
      "default": "flameox.kernel-build.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_environment": {
      "additionalProperties": {
        "maxLength": 500,
        "type": "string"
      },
      "propertyNames": {
        "maxLength": 100,
        "minLength": 1
      },
      "title": "Source Environment",
      "type": "object"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/KernelBuildStage"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Stages",
      "type": "array"
    },
    "workload_label": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Workload Label",
      "type": "string"
    }
  },
  "required": [
    "producer",
    "producer_version",
    "outcome",
    "stages",
    "workload_label",
    "build_context"
  ],
  "title": "KernelBuildManifestV2",
  "type": "object"
}
